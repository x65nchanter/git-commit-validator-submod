#!/usr/bin/env bash

# ==============================================================================
# GIT COMMIT VALIDATOR HOOKS
# ==============================================================================
# Description: Executes a dynamic validation strategy based on the repository
#              configuration payload.
# ==============================================================================

set -e

COMMIT_MSG_FILE="$1"
COMMIT_MSG_CONTENT=$(cat "$COMMIT_MSG_FILE")

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FORMATS_DIR="$HOOKS_DIR/../formats"

if [[ "$COMMIT_MSG_CONTENT" =~ ^(Revert|Merge) ]]; then
    exit 0
fi

ACTIVE_FORMAT=$(git config local.commitValidator.format || echo "conventional-commits")
TARGET_STRATEGY_SCRIPT="$FORMATS_DIR/${ACTIVE_FORMAT}"

if [ ! -f "$TARGET_STRATEGY_SCRIPT" ]; then
    echo -e "\n\033[31m[ERROR] Runtime execution failed: Invalid validation strategy.\033[0m"
    echo -e "The requested strategy configuration module \033[33m'$ACTIVE_FORMAT'\033[0m does not exist."
    echo -e "Location scanned: $TARGET_STRATEGY_SCRIPT"
    echo -e "Action required: Verify local git configuration or update the tracking submodule.\n"
    exit 1
fi

source "$TARGET_STRATEGY_SCRIPT"

if ! validate_format "$COMMIT_MSG_CONTENT"; then
    echo -e "\n\033[31m[ERROR] Commit rejected: Structural specification violation.\033[0m"
    echo -e "Active validation profile: \033[36m$ACTIVE_FORMAT\033[0m"
    echo -e "Captured input string: \033[33m$COMMIT_MSG_CONTENT\033[0m"

    if function_exists print_format_specification_hint; then
        print_format_specification_hint
    else
        echo -e "Action required: Ensure compliance with the active repository formatting standards.\n"
    fi
    exit 1
fi

exit 0
